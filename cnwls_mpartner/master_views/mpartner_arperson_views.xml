<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="cnwls_mpartner_arperson_tree">
            <field name="name">cnwls.mpartner.arperson.tree</field>
            <field name="model">cnwls.mpartner.arperson</field>
            <field name="arch" type="xml">
                <list string="AR Person List" editable="top"   >
                    <field name="company_id" readonly="1" />
                    <field name="name"  /> 
                    <field name="webcode"  />   
                </list>
            </field>
        </record>
         
        <!-- actions opening views on models -->
        <record model="ir.actions.act_window" id="cnwls_mpartner_arperson_action">
            <field name="name">AR Person List</field>
            <field name="res_model">cnwls.mpartner.arperson</field>
            <field name="view_mode">list</field>
        </record>


    </data>
</odoo>