<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="cnwls_mpartner_sales_tree">
            <field name="name">cnwls.mpartner.sales.tree</field>
            <field name="model">cnwls.mpartner.sales</field>
            <field name="arch" type="xml">
                <list string="Sales List" editable="top"   >
                    <field name="company_id" readonly="1" />
                    <field name="name"  /> 
                    <field name="slsempname"  /> 
                    <field name="no_telp"  /> 
                    <field name="email"  />  
                </list>
            </field>
        </record>
         
        <!-- actions opening views on models -->
        <record model="ir.actions.act_window" id="cnwls_mpartner_sales_action">
            <field name="name">Sales List</field>
            <field name="res_model">cnwls.mpartner.sales</field>
            <field name="view_mode">list</field>
        </record>


    </data>
</odoo>