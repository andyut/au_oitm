<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="cnwls_mpartner_octg_tree">
            <field name="name">cnwls.mpartner.octg.tree</field>
            <field name="model">cnwls.mpartner.octg</field>
            <field name="arch" type="xml">
                <list string="TOP List" editable="top"   >
                    <field name="company_id" readonly="1" />
                    <field name="name"  /> 
                    <field name="groupnum"  />  
                    <field name="extradays"  />  
                </list>
            </field>
        </record>
         
        <!-- actions opening views on models -->
        <record model="ir.actions.act_window" id="cnwls_mpartner_octg_action">
            <field name="name">TOP List</field>
            <field name="res_model">cnwls.mpartner.octg</field>
            <field name="view_mode">list</field>
        </record>


    </data>
</odoo>